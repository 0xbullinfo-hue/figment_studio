<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/$ [OR]
  RewriteCond %{REQUEST_URI} ^/(about|contact|works|portfolio|insights|academy|arcviz|estimator|feedback|auth|dashboard|admin|billing|payment|assets|support|profile|new-project|success)/?$ [OR]
  RewriteCond %{REQUEST_URI} ^/insights/.+$ [OR]
  RewriteCond %{REQUEST_URI} ^/works/.+$ [OR]
  RewriteCond %{REQUEST_URI} ^/project/.+$
  RewriteRule . /index.html [L]

  RewriteRule . /404.html [R=404,L]
</IfModule>
